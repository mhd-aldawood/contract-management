COMPOSE_PROJECT_NAME=contract-management
COMPOSE_ENV_FILE=.env

DJANGO_SETTINGS_MODULE=contract_management_BE.settings
API_DEFAULT_LANGUAGE=ar
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DEBUG=False

# Public frontend and API subdomains.
ALLOWED_HOSTS=cm-dev.svuonline.edu.sy,cmapi-dev.svuonline.edu.sy,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://cm-dev.svuonline.edu.sy,https://cmapi-dev.svuonline.edu.sy
# Only browser origins that call the API belong here. The API's own origin is
# same-origin and does not need a CORS entry.
CORS_ALLOWED_ORIGINS=https://cm-dev.svuonline.edu.sy
CORS_ALLOW_CREDENTIALS=False

STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

POSTGRES_DB=contract_management
POSTGRES_USER=contract_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=postgres
DATABASE_CONN_MAX_AGE=60

USE_SQLITE_FOR_TESTS=True
SQLITE_TEST_PATH=/tmp/contract-management-test.sqlite3

# Optional Django super admin bootstrap (used by backend entrypoint.sh).
# Set all three to create/promote this super admin on container start.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PGADMIN_PASSWORD
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# The frontend appends /api/... to this value. No trailing slash.
VITE_API_BASE_URL=https://cmapi-dev.svuonline.edu.sy
