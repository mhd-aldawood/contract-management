COMPOSE_PROJECT_NAME=contract-management
# Keep Docker services private to this host. The host Nginx proxies to APP_PORT.
BIND_ADDRESS=127.0.0.1
APP_PORT=81
BACKEND_PORT=8000
FRONTEND_PORT=8081
PGADMIN_PORT=5050
POSTGRES_EXPOSED_PORT=5432

DJANGO_SETTINGS_MODULE=contract_management_BE.settings
API_DEFAULT_LANGUAGE=ar
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,cm.localhost,cmapi.localhost,cm-dev.svuonline.edu.sy,cmapi-dev.svuonline.edu.sy
CSRF_TRUSTED_ORIGINS=http://localhost:81,http://127.0.0.1:81,http://localhost:8081,http://127.0.0.1:8081,http://cm.localhost:81,http://cmapi.localhost:81,https://cm-dev.svuonline.edu.sy,https://cmapi-dev.svuonline.edu.sy
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:81,http://127.0.0.1:81,http://localhost:8081,http://127.0.0.1:8081,http://cm.localhost:81,https://cm-dev.svuonline.edu.sy
CORS_ALLOW_CREDENTIALS=False
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

POSTGRES_DB=contract_management
POSTGRES_USER=contract_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=60
USE_SQLITE_FOR_TESTS=True
SQLITE_TEST_PATH=/tmp/contract-management-test.sqlite3

# Optional Django super admin bootstrap (used by backend entrypoint.sh).
# When all three are set, the container creates/promotes this super admin on start.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=StrongPass!23

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password
PGADMIN_CONFIG_SERVER_MODE=False
PGADMIN_CONFIG_MASTER_PASSWORD_REQUIRED=False

# Local hostname-based test. The frontend appends /api/... to this origin.
VITE_API_BASE_URL=http://cmapi.localhost:81
