    {
      "name": "Agreements",
      "item": [
        {
          "name": "Planning - all visible agreements",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/planning/agreements/" },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Planning list loads', () => pm.response.to.have.status(200));",
              "pm.test('Hidden agreements are excluded', () => pm.response.json().data.forEach(item => pm.expect(item.isHidden).to.eql(false)));",
              "pm.test('Each agreement has a date classification', () => pm.response.json().data.forEach(item => pm.expect(['finish', 'current', 'future', 'unknown']).to.include(item.planningPhase)));"
            ] }
          }]
        },
        {
          "name": "Planning - finished agreements",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/planning/agreements/?phase=finish" }
        },
        {
          "name": "Planning - current agreements",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/planning/agreements/?phase=current" }
        },
        {
          "name": "Planning - future agreements",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/planning/agreements/?phase=future" }
        },
