{
  "info": {
    "_postman_id": "663e814e-7de0-4dc5-9b8b-d4103a962c4d",
    "name": "Contract Management API",
    "description": "API and Nginx gateway checks for Contract Management. Select the Local or Production Postman environment, then run Signup or Login first to populate that environment's token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "value", "value": "Token {{token}}", "type": "string" },
      { "key": "key", "value": "Authorization", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://cmapi.localhost:81" },
    { "key": "dashboardUrl", "value": "http://cm.localhost:81" },
    { "key": "localBaseUrl", "value": "http://cmapi.localhost:81" },
    { "key": "productionBaseUrl", "value": "https://cmapi-dev.svuonline.edu.sy" },
    { "key": "username", "value": "postman_user" },
    { "key": "email", "value": "postman@example.com" },
    { "key": "password", "value": "PostmanTest123!" },
    { "key": "token", "value": "" },
    { "key": "educational_content_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Nginx service checks",
      "item": [
        {
          "name": "API gateway health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz",
            "description": "Checks the API hostname through the Nginx gateway."
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Gateway is healthy', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Dashboard gateway health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{dashboardUrl}}/health",
            "description": "Checks the dashboard hostname through the Nginx gateway."
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Dashboard is healthy', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Dashboard home through Nginx",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{dashboardUrl}}/",
            "description": "Confirms the dashboard hostname is routed to Vue."
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Dashboard is reachable', () => pm.response.to.have.status(200));"] }
          }]
        },
        {
          "name": "Django admin through Nginx",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/login/",
            "description": "Confirms the API hostname is routed to Django."
          },
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Django admin is reachable', () => pm.response.to.have.status(200));"] }
          }]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.request.headers.remove('Authorization');",
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('username', `postman_user_${suffix}`);",
                  "pm.collectionVariables.set('email', `postman_${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.data?.token) pm.environment.set('token', data.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"password2\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/signup/"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.request.headers.remove('Authorization');"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.data?.token) pm.environment.set('token', data.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login/"
          }
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/auth/me/" }
        },
        {
          "name": "Refresh token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Token rotated', () => pm.response.to.have.status(200));",
                "const data = pm.response.json();",
                "if (data.data?.key) pm.environment.set('token', data.data.key);"
              ]
            }
          }],
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/token/refresh/" }
        }
      ]
    },
    {
      "name": "Educational content",
      "item": [
        {
          "name": "List educational content",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/educational-contents" }
        },
        {
          "name": "Create educational content",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Content created', () => pm.response.to.have.status(201));",
                "const data = pm.response.json();",
                "if (data.data?.id) pm.collectionVariables.set('educational_content_id', data.data.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"educational-content\",\n  \"agreementNumber\": \"EDU-POSTMAN-001\",\n  \"name\": \"Postman educational agreement\",\n  \"companyName\": \"Example Company\",\n  \"subject\": \"API test\",\n  \"estimatedCost\": \"1000.00\",\n  \"startDate\": \"2026-10-11\",\n  \"endDate\": \"2026-12-31\",\n  \"paymentMethod\": \"table\",\n  \"paymentText\": \"\",\n  \"paymentSchedule\": [{\"label\": \"First payment\", \"amount\": \"1000.00\", \"dueDate\": \"2026-11-01\", \"order\": 0}],\n  \"quarterlyDue\": \"250.00\",\n  \"status\": \"active\",\n  \"disbursement\": \"pending\",\n  \"budgetType\": \"current\",\n  \"contractText\": \"Created from Postman\",\n  \"isHidden\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/educational-contents"
          }
        },
        {
          "name": "Get educational content",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/educational-contents/{{educational_content_id}}/" }
        },
        {
          "name": "Update educational content",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"updated-from-postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/educational-contents/{{educational_content_id}}/"
          }
        },
        {
          "name": "Delete educational content",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/educational-contents/{{educational_content_id}}/" }
        }
      ]
    },
    {
