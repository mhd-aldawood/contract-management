          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/educational-contents" }
        },
        {
          "name": "Create educational content",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Content created', () => pm.response.to.have.status(201));",
                "const data = pm.response.json();",
                "if (data.data?.id) pm.collectionVariables.set('educational_content_id', data.data.id);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"educational-content\",\n  \"agreementNumber\": \"EDU-POSTMAN-001\",\n  \"name\": \"Postman educational agreement\",\n  \"companyName\": \"Example Company\",\n  \"subject\": \"API test\",\n  \"estimatedCost\": \"1000.00\",\n  \"startDate\": \"2026-10-11\",\n  \"endDate\": \"2026-12-31\",\n  \"reminderDate\": \"2026-12-15\",\n  \"paymentMethod\": \"table\",\n  \"paymentText\": \"\",\n  \"paymentSchedule\": [{\"label\": \"First payment\", \"amount\": \"1000.00\", \"dueDate\": \"2026-11-01\", \"order\": 0}],\n  \"quarterlyDue\": \"250.00\",\n  \"status\": \"active\",\n  \"disbursement\": \"pending\",\n  \"budgetType\": \"current\",\n  \"contractText\": \"Created from Postman\",\n  \"isHidden\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/educational-contents"
          }
        },
        {
          "name": "Get educational content",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/educational-contents/{{educational_content_id}}/" }
        },
        {
          "name": "Update educational content",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"updated-from-postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/educational-contents/{{educational_content_id}}/"
          }
        },
        {
          "name": "Delete educational content",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/educational-contents/{{educational_content_id}}/" }
        }
      ]
