    },
    {
      "name": "Session cleanup",
      "description": "Run this folder last because logout invalidates the token used by protected requests.",
      "item": [
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/logout/" }
        }
      ]
    }
  ]
}
