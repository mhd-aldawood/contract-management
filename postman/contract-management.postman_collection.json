{
  "info": {
    "_postman_id": "663e814e-7de0-4dc5-9b8b-d4103a962c4d",
    "name": "Contract Management API",
    "description": "API and Nginx gateway checks for Contract Management. Select the Local or Production Postman environment, then run Login first to populate that environment's token. User accounts are created only by administrators through User Management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "value", "value": "Token {{token}}", "type": "string" },
      { "key": "key", "value": "Authorization", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://cmapi.localhost:81" },
    { "key": "dashboardUrl", "value": "http://cm.localhost:81" },
    { "key": "localBaseUrl", "value": "http://cmapi.localhost:81" },
    { "key": "productionBaseUrl", "value": "https://cmapi-dev.svuonline.edu.sy" },
    { "key": "username", "value": "postman_user" },
    { "key": "email", "value": "postman@example.com" },
    { "key": "password", "value": "PostmanTest123!" },
    { "key": "token", "value": "" },
    { "key": "educational_content_id", "value": "1" },
    { "key": "managed_user_id", "value": "1" },
    { "key": "managed_username", "value": "managed_user" },
    { "key": "temporary_password", "value": "" },
    { "key": "finance_agreement_type", "value": "nafath-centers" },
    { "key": "finance_agreement_id", "value": "1" },
    { "key": "disbursement_order_id", "value": "1" },
    { "key": "dean_agreement_type", "value": "nafath-centers" },
    { "key": "dean_agreement_id", "value": "1" },
    { "key": "dean_order_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Dashboard - Role and permission scoped metrics",
      "description": "Login as each role, then request the dashboard. Home read permission is required. Planning excludes hidden agreements. Finance metrics require Finance or Dean access. User counts are aggregate-only for Dean; user management remains Admin-only. No sample metrics are generated.",
      "item": [{
        "name": "Get my live dashboard",
        "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dashboard/" },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Dashboard loads', () => pm.response.to.have.status(200));",
          "const dashboard = pm.response.json().data;",
          "pm.test('Counts are numeric and months are bounded', () => { pm.expect(dashboard.agreements.total).to.be.a('number'); pm.expect(dashboard.charts.monthly).to.have.lengthOf(6); });",
          "if (dashboard.mode === 'planning') pm.test('Planning visibility enforced', () => { pm.expect(dashboard.agreements.hidden).to.eql(0); pm.expect(dashboard.recentAgreements.every(item => !item.isHidden)).to.eql(true); });"
        ] } }]
      }]
    },
    {
      "name": "Dean - Agreement review and Planning visibility",
      "description": "Login as Admin or Dean. Dean read permission lists every agreement, including hidden records, and reads details and Finance order files. Dean write permission changes only Planning visibility. Showing or hiding a document changes the next Planning list response. List and detail requests select the first available document and order; choose another ID as needed.",
      "item": [
        {
          "name": "List all agreements including hidden",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dean/agreements/" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Dean list loads', () => pm.response.to.have.status(200));",
            "const first = pm.response.json().data?.[0]; if (first) { pm.environment.set('dean_agreement_type', first.feature); pm.environment.set('dean_agreement_id', first.id); }"
          ] } }]
        },
        {
          "name": "Read agreement details and active Finance orders",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dean/agreements/{{dean_agreement_type}}/{{dean_agreement_id}}/" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Dean details load', () => pm.response.to.have.status(200));",
            "const first = pm.response.json().data?.orders?.[0]; if (first) pm.environment.set('dean_order_id', first.id);"
          ] } }]
        },
        {
          "name": "Show agreement in Planning",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/dean/agreements/{{dean_agreement_type}}/{{dean_agreement_id}}/visibility/",
            "body": { "mode": "raw", "raw": "{\n  \"isHidden\": false\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Agreement shown', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.isHidden).to.eql(false); });"
          ] } }]
        },
        {
          "name": "Hide agreement from Planning",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/dean/agreements/{{dean_agreement_type}}/{{dean_agreement_id}}/visibility/",
            "body": { "mode": "raw", "raw": "{\n  \"isHidden\": true\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Agreement hidden', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.isHidden).to.eql(true); });"
          ] } }]
        },
        {
          "name": "Download Finance order with Dean permission",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/dean/agreements/{{dean_agreement_type}}/{{dean_agreement_id}}/orders/{{dean_order_id}}/file/" }
        }
      ]
    },
    {
      "name": "Finance - Disbursement orders",
      "description": "Finance read permission lists agreements and downloads files. Finance write permission adds, replaces, or removes orders. Select actual files in multipart requests; do not manually set Content-Type. Hidden agreements remain available to Finance.",
      "item": [
        {
          "name": "List agreements and order counts",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/finance/agreements/" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Finance list loads', () => pm.response.to.have.status(200));",
            "const first = pm.response.json().data?.[0]; if (first) { pm.environment.set('finance_agreement_type', first.feature); pm.environment.set('finance_agreement_id', first.id); }"
          ] } }]
        },
        {
          "name": "List agreement disbursement orders",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/finance/agreements/{{finance_agreement_type}}/{{finance_agreement_id}}/orders/" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Orders list loads', () => pm.response.to.have.status(200));",
            "const first = pm.response.json().data?.[0]; if (first) pm.environment.set('disbursement_order_id', first.id);"
          ] } }]
        },
        {
          "name": "Upload one or more disbursement orders",
          "request": {
            "method": "POST", "header": [],
            "url": "{{baseUrl}}/api/finance/agreements/{{finance_agreement_type}}/{{finance_agreement_id}}/orders/",
            "description": "Select one or multiple files under files. Up to 20 files / 19 MiB total; PDF, PNG, JPG, JPEG, DOC, DOCX, XLS, XLSX, TXT.",
            "body": { "mode": "formdata", "formdata": [{ "key": "files", "type": "file", "src": [] }] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Orders uploaded', () => pm.response.to.have.status(201));",
            "const first = pm.response.json().data?.[0]; if (first) pm.environment.set('disbursement_order_id', first.id);"
          ] } }]
        },
        {
          "name": "Edit selected order name and notes",
          "request": {
            "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/finance/agreements/{{finance_agreement_type}}/{{finance_agreement_id}}/orders/{{disbursement_order_id}}/",
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"أمر الصرف الأول\",\n  \"notes\": \"ملاحظات المالية\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Replace selected order file",
          "request": {
            "method": "PATCH", "header": [],
            "url": "{{baseUrl}}/api/finance/agreements/{{finance_agreement_type}}/{{finance_agreement_id}}/orders/{{disbursement_order_id}}/",
            "description": "Replaces this order's file, retaining its ID. Other orders are unchanged.",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] }
          }
        },
        {
          "name": "Download selected order (authenticated)",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/finance/agreements/{{finance_agreement_type}}/{{finance_agreement_id}}/orders/{{disbursement_order_id}}/file/" }
        },
        {
          "name": "Remove selected order",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/finance/agreements/{{finance_agreement_type}}/{{finance_agreement_id}}/orders/{{disbursement_order_id}}/" }
        }
      ]
    },
