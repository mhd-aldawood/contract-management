    {
      "name": "User management (Admin only)",
      "item": [
        {
          "name": "List and filter users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/users/?q=&role=&active=true"
          }
        },
        {
          "name": "Create user with generated password",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": ["pm.collectionVariables.set('managed_username', `managed_user_${Date.now()}`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "if (data?.user?.id) pm.collectionVariables.set('managed_user_id', data.user.id);",
                  "if (data?.temporaryPassword) pm.collectionVariables.set('temporary_password', data.temporaryPassword);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{managed_username}}\",\n  \"email\": \"{{managed_username}}@example.com\",\n  \"roleCode\": \"contract\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/users/"
          }
        },
        {
          "name": "Update user and role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"updated@example.com\",\n  \"roleCode\": \"finance\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/users/{{managed_user_id}}/"
          }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/users/{{managed_user_id}}/"
          }
        },
        {
          "name": "Reset user password",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const data = pm.response.json().data;",
                "if (data?.temporaryPassword) pm.collectionVariables.set('temporary_password', data.temporaryPassword);"
              ]
            }
          }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetPassword\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/users/{{managed_user_id}}/"
          }
        },
        {
          "name": "Activate user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/users/{{managed_user_id}}/"
          }
        },
        {
          "name": "Login with temporary password",
          "event": [{
            "listen": "prerequest",
            "script": { "exec": ["pm.request.headers.remove('Authorization');"] }
          }, {
            "listen": "test",
            "script": {
              "exec": [
                "const data = pm.response.json().data;",
                "if (data?.token) pm.environment.set('token', data.token);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{managed_username}}\",\n  \"password\": \"{{temporary_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login/"
          }
        },
        {
          "name": "Submit new password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{temporary_password}}\",\n  \"newPassword\": \"NewStrongPassword123!\",\n  \"newPassword2\": \"NewStrongPassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/change-password/"
          }
        }
      ]
    },
    {
      "name": "Access control (Admin only)",
      "item": [
        {
          "name": "Get role permission matrix",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/access-control/"
          }
        },
        {
          "name": "Create role",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleCode\": \"auditor\",\n  \"roleName\": \"Auditor\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/access-control/"
          }
        },
        {
          "name": "Update role feature permission",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleCode\": \"finance\",\n  \"feature\": \"educational-content\",\n  \"read\": true,\n  \"write\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/access-control/"
          }
        },
        {
          "name": "Delete custom role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleCode\": \"auditor\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/access-control/"
          }
        }
      ]
    },
    {
      "name": "Session cleanup",
      "description": "Run this folder last because logout invalidates the token used by protected requests.",
      "item": [
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [], "url": "{{baseUrl}}/api/auth/logout/" }
        }
      ]
    }
  ]
}
